GATEWAY_JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAsnKREs77xFdVkkeN79Yd\nzSktiFOeSZZbB+Xpo+ipJmwerw4d+YGnh9aZbQ6SBnQMVJ/8N9/yT4WVsRqKegsN\nz054F41dg4pwFEfqSw3QBgCG+FAao0m6WSx4rKaexJE9akiAIocXpMh9hlHuxUPB\nUhtDRS3/W68EsS71C1rxnDEH5+JfRRZLBV0ahC1Z5y8+0+zRvqBJ7vW9uZWah4VC\nAZhja5nZ+1cBftnPAtVyLW/ClD5d0/NRpuKbNNV6R7fAoQcEs7KoKXuAvV11lRtg\nRq8xPVkqt0q2QQFBcnvm+XwCftvJNxECXTc4Q5FuJyURr/2j1THdH8BZjvd6KIPc\nLQIDAQAB\n-----END PUBLIC KEY-----
MEMBERS_PUBLIC_URL=http://localhost:5173
MEMBERS_SMTP_HOST=mailpit
MEMBERS_SMTP_PORT=1025
MEMBERS_SMTP_FROM=gimnasio@gym.local
MEMBERS_SMTP_USER=
MEMBERS_SMTP_PASSWORD=
# true exclusivamente para Mailpit local sin credenciales; producción exige TLS.
MEMBERS_SMTP_ALLOW_PLAINTEXT=true
# Administrador inicial (users.v1): se crea una sola vez al arrancar con identidad
# habilitada; nunca se sobrescribe. Contraseña de 12 a 72 caracteres. Valores solo
# para desarrollo: en cualquier otro entorno usar credenciales propias.
MEMBERS_ADMIN_EMAIL=admin@gym.local
MEMBERS_ADMIN_PASSWORD=dev-admin-change-me
MEMBERS_ADMIN_NAME=Administrador

# --- Clases y reservas (booking.v1, etapa 4) -----------------------------------
# Requiere la identidad habilitada y GYM_INTERNAL_SERVICE_KEY (consulta a Members).
BOOKING_ENABLED=true
# Cada cuánto se cierran las clases terminadas y se registran ausencias (RN-38).
BOOKING_CLOSE_INTERVAL=30s

# --- Mensajería local (etapa 5; activar ambos junto con identidad) -------------
MEMBERS_MESSAGING_ENABLED=true
NOTIFICATION_MESSAGING_ENABLED=true
# URLs AMQP se forman en Compose; al ejecutar binarios configurar
# MEMBERS_AMQP_URL y NOTIFICATION_AMQP_URL con usuario y clave del broker.
NOTIFICATION_SMTP_HOST=mailpit
NOTIFICATION_SMTP_PORT=1025
NOTIFICATION_SMTP_FROM=gimnasio@gym.local
NOTIFICATION_SMTP_ALLOW_PLAINTEXT=true

# --- Booking → Benefits (etapa 6; activar ambos con BOOKING_ENABLED) ----------
BOOKING_MESSAGING_ENABLED=true
BENEFITS_MESSAGING_ENABLED=true
# Compose forma las URLs; para binarios usar BOOKING_AMQP_URL y BENEFITS_AMQP_URL.

# --- Búsqueda de clases en OpenSearch (etapa 8, ADR-014) --------------------------
# Requiere BOOKING_ENABLED y BOOKING_MESSAGING_ENABLED. OpenSearch corre con el
# perfil "search": docker compose --profile search ... (ver ETAPA_8_BUSQUEDA.md).
BOOKING_SEARCH_ENABLED=true
BOOKING_INDEXER_ENABLED=true

# --- Caché del catálogo de actividades (etapa 9, ADR-007, D-88) -------------------
# Cache-aside en Redis con TTL de 10 min e invalidación al modificar una actividad.
BOOKING_CACHE_ENABLED=true

# --- Entrenamiento y nutrición (etapa 10, training.v1) ---------------------------
# Requiere identidad habilitada y GYM_INTERNAL_SERVICE_KEY (asignaciones en Members).
TRAINING_ENABLED=true

# --- Observabilidad (etapa 14): Prometheus en 9090 y Grafana en 3000, solo loopback ---
# Grafana abre el tablero sin login (lectura); el administrador usa esta clave.
GRAFANA_ADMIN_PASSWORD=04bc7880772ab1ed10b73f82df86aa7f
